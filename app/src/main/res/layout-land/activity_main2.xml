<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape-optimized MainActivity2 with horizontal tab bar:
     Left: FragmentCommon (status info) - 280dp
     Right: scrolling list of sections (Advanced Mode) - remaining space
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main2_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context="uk.org.openseizuredetector.activity.main.MainActivity2">

    <LinearLayout
        android:id="@+id/activity_main2_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left Column: Status Card (FragmentCommon) - Fixed width 280dp for readable buttons -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_common_container_view"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceVariant" />

        <!-- Right Column: scrolling list of sections -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Advanced Mode: the sections (OSD, Flap, ML, HR, Fall, system status, signal, battery)
             are stacked here one below the other, in the order chosen in the settings, and the
             user scrolls through them. MainActivity2 fills sections_container with one
             fragment container per section. Replaces the old tabs. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/sections_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/sections_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>




