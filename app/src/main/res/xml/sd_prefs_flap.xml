<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="Flap Alarm Settings">
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="FlapAlarmActive"
            android:title="@string/flap_alarm_title" />

        <Preference
            android:key="flap_description"
            android:summary="@string/flap_is_a_feature_to_detect_large_arm_movements"
            android:selectable="false" />

        <EditTextPreference
            android:defaultValue="5000"
            android:key="FlapAlarmThresh"
            android:summary="@string/flap_alarm_threshold"
            android:title="Flap Alarm Threshold" />
        <EditTextPreference
            android:defaultValue="90"
            android:key="FlapAlarmRatioThresh"
            android:summary="@string/flap_alarm_ratio_threshold"
            android:title="@string/flap_alarm_ratio_threshold" />
        <EditTextPreference
            android:defaultValue="2"
            android:key="FlapAlarmFreqMin"
            android:summary="@string/FlapAlarmFreqMinSummary"
            android:title="@string/FlapAlarmFreqMinTitle" />
        <EditTextPreference
            android:defaultValue="4"
            android:key="FlapAlarmFreqMax"
            android:summary="@string/FlapAlarmFreqMaxSummary"
            android:title="@string/FlapAlarmFreqMaxTitle" />
    </PreferenceCategory>
</PreferenceScreen>
