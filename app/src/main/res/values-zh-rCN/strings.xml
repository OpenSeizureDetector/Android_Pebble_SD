  <string name="onboarding_welcome_title">欢迎使用 OpenSeizureDetector</string>
  <string name="onboarding_welcome_subtitle">本向导将帮助您按需要配置 OpenSeizureDetector。</string>
  <string name="onboarding_welcome_description">您将完成以下步骤：\n\n• 选择数据源\n• 配置数据源\n• 选择发作检测算法\n\n稍后可在“设置”菜单中修改。</string>
  <string name="onboarding_datasource_title">选择数据源</string>
  <string name="onboarding_datasource_subtitle">请选择发作检测数据的来源：</string>
  <string name="onboarding_datasource_phone">手机（演示模式）</string>
  <string name="onboarding_datasource_phone_desc">使用手机加速度传感器进行测试，不适合实际发作检测。</string>
  <string name="onboarding_datasource_pinetime">PineTime 手表（推荐）</string>
  <string name="onboarding_datasource_pinetime_desc">使用低成本 PineTime 手表进行发作检测。</string>
  <string name="onboarding_datasource_garmin">Garmin 手表</string>
  <string name="onboarding_datasource_garmin_desc">使用 Garmin 智能手表进行发作检测和心率监测。</string>
  <string name="onboarding_datasource_network">网络（远程监测）</string>
  <string name="onboarding_datasource_network_desc">连接另一台运行 OpenSeizureDetector 的设备，接收远程报警。</string>
  <string name="onboarding_algorithms_title">选择检测算法</string>
  <string name="onboarding_algorithms_subtitle">选择需要使用的发作检测算法，可同时启用多个算法。</string>
  <string name="onboarding_algorithms_ml">机器学习算法（推荐）</string>
  <string name="onboarding_algorithms_ml_desc">使用机器学习（AI）检测。\n相比原始 OSD 算法，具有较少的误报。\n用户通过“数据共享”报告误报和真实发作，可帮助后续模型改善表现。</string>
  <string name="onboarding_algorithms_hr">心率提醒</string>
  <string name="onboarding_algorithms_hr_desc">检测异常心率。目前需要 Garmin 手表提供可靠的心率测量。</string>
  <string name="onboarding_algorithms_osd">OSD 算法</string>
  <string name="onboarding_algorithms_osd_desc">原始 OpenSeizureDetector 确定性算法。\n用于强直－阵挛发作检测，适合夜间使用；刷牙、洗碗等重复运动可能引发误报。</string>
  <string name="onboarding_algorithms_flap">OSD 算法（含手臂摆动检测）</string>
  <string name="onboarding_algorithms_flap_desc">增强版 OSD 算法，可检测手臂反复摆动，以改善夜间强直－阵挛发作检测。</string>
  <string name="onboarding_algorithms_note">注意：至少启用一个算法，发作检测才能运行。</string>
  <string name="onboarding_complete_title">设置完成！</string>
  <string name="onboarding_complete_subtitle">OpenSeizureDetector 已准备就绪。</string>
