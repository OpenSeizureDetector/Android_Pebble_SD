<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".activity.main.FragmentFallAlg">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- Shown instead of the content when the algorithm is not selected by the user
                 (only possible with the Advanced Mode option "show all algorithms"). -->
            <TextView
                android:id="@+id/alg_inactive_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/algorithm_not_selected"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:visibility="gone" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/alg_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="@string/fall_algorithm"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/fragment_fall_alg_tv1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fall_algorithm_status"
                android:layout_marginBottom="8dp" />

            <!-- Current window min/max acceleration values -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/window_min_accel" />

                <TextView
                    android:id="@+id/fall_window_min_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mg" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/window_max_accel" />

                <TextView
                    android:id="@+id/fall_window_max_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mg" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Status info (alarm state, alarm standing) -->
            <TextView
                android:id="@+id/fall_status_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_info"
                android:layout_marginBottom="16dp" />

            <!--
                Fall detection acceleration history graph.
                Solid lines: min accel (blue/accent) and max accel (red).
                Dashed lines: FallThreshMin (blue/accent dashed) and FallThreshMax (red dashed).
                Orange circles: times when a fall alarm was raised.
            -->
            <uk.org.openseizuredetector.activity.main.ZoomableGraphView
                android:id="@+id/fall_line_chart"
                android:layout_width="match_parent"
                android:layout_height="250dp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>

