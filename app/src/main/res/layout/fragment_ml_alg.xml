<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".activity.main.FragmentMlAlg">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <!-- Shown instead of the content when the algorithm is not selected by the user
                 (only possible with the Advanced Mode option "show all algorithms"). -->
            <TextView
                android:id="@+id/alg_inactive_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/algorithm_not_selected"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:visibility="gone" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/alg_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


            <TextView
                android:id="@+id/fragment_ml_alg_tv1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                android:text="@string/machine_learning_algorithm_status"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/fragment_ml_alg_model_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- Grid container for up to 6 models (2 columns x 3 rows) -->
            <GridLayout
                android:id="@+id/individual_models_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:useDefaultMargins="true"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/ml_chart_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/seizure_probability_history_last_10_minutes"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Custom Legend Display (bypasses GraphView's broken legend sizing) -->
            <HorizontalScrollView
                android:id="@+id/legend_scroll_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/custom_legend_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="?attr/colorSurfaceVariant" />
            </HorizontalScrollView>

            <uk.org.openseizuredetector.activity.main.ZoomableGraphView
                android:id="@+id/seizure_history_chart"
                android:layout_width="match_parent"
                android:layout_height="280dp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
