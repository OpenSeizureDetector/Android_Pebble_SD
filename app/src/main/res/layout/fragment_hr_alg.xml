<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".activity.main.FragmentHrAlg">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- Shown instead of the content when the algorithm is not selected by the user
                 (only possible with the Advanced Mode option "show all algorithms"). -->
            <TextView
                android:id="@+id/alg_inactive_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/algorithm_not_selected"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:visibility="gone" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/alg_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="@string/heart_rate_algorithm"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/fragment_hr_alg_tv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_algorithm_status"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_hr" />

            <TextView
                android:id="@+id/current_hr_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bpm" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adaptive_threshold_average_hr" />

            <TextView
                android:id="@+id/adaptive_avg_hr_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bpm" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_info"
            android:layout_marginBottom="16dp" />

        <uk.org.openseizuredetector.activity.main.ZoomableGraphView
            android:id="@+id/lineChart"
            android:layout_width="match_parent"
            android:layout_height="250dp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
